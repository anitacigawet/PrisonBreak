# PrisonBreak runtime configuration.
# Copy this file to .env. Do not commit .env or provider credentials.

# SQLite database location. Created on first run.
DATABASE_PATH=./data/app.db
# Optional root for settings, uploads, snapshots and retrieval storage.
# If set, also remove or adjust DATABASE_PATH above to keep all state together.
# PRISONBREAK_DATA_DIR=C:\path\to\prisonbreak-data

# Server port (auto-falls-through to the next free port if busy).
PORT=3000

# Only loopback hosts are supported: 127.0.0.1, localhost, or ::1.
HOST=127.0.0.1

# Live web-research CLI used by Grow.
# Claude Code must already be installed and authenticated; it uses external
# web services. Codex remains a recognized selection but fails closed until
# its web-only tool/filesystem isolation is verified. No automatic fallback.
PRISONBREAK_RESEARCH_PROVIDER=claude

# Optional executable overrides when the CLI is not on PATH.
# PRISONBREAK_RESEARCH_CODEX_BIN=C:\path\to\codex.exe
# PRISONBREAK_RESEARCH_CLAUDE_BIN=C:\path\to\claude.exe

# Python interpreter used by the local RAG worker. Defaults to "python" on
# Windows and "python3" elsewhere.
# Windows: PRISONBREAK_PYTHON=.\.venv-rag\Scripts\python.exe
# macOS/Linux: PRISONBREAK_PYTHON=./.venv-rag/bin/python

# Optional local Qdrant, collection, embedding-model, and model-cache paths.
# Qdrant and FastEmbed run locally; the default embedding model may be
# downloaded the first time it is used.
# PRISONBREAK_QDRANT_PATH=./data/qdrant
# PRISONBREAK_RAG_COLLECTION=prisonbreak_rag_v1
# PRISONBREAK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# PRISONBREAK_FASTEMBED_CACHE=./data/fastembed
